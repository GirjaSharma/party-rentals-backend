generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String     @db.Uuid
  customer_id      String     @db.Uuid
  source           String     @default("manual")
  event_date       DateTime   @db.Date
  fulfillment_type String
  booking_status   String     @default("pending")
  items_out_date   DateTime?  @db.Date
  items_back_date  DateTime?  @db.Date
  items_out_at     DateTime?  @db.Time(6)
  items_back_at    DateTime?  @db.Time(6)
  delivery_fee     Decimal?   @default(0) @db.Decimal(10, 2)
  setup_fee        Decimal?   @default(0) @db.Decimal(10, 2)
  discount         Decimal?   @default(0) @db.Decimal(10, 2)
  tax              Decimal?   @default(0) @db.Decimal(10, 2)
  notes            String?
  created_at       DateTime?  @default(now()) @db.Timestamp(6)
  updated_at       DateTime?  @default(now()) @db.Timestamp(6)
  total_amount     Decimal?   @default(0) @db.Decimal(10, 2)
  created_by       String?    @db.Uuid
  users            users?     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  businesses       businesses @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bookings_business")
  customers        customers  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bookings_customer")
  payments         payments[]

  @@index([business_id], map: "idx_bookings_business_id")
  @@index([business_id, booking_status], map: "idx_bookings_business_status")
  @@index([customer_id], map: "idx_bookings_customer_id")
  @@index([event_date], map: "idx_bookings_event_date")
}

model businesses {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String?           @unique
  timezone        String?
  currency        String?           @default("USD")
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  bookings        bookings[]
  customers       customers[]
  inventory_items inventory_items[]
  memberships     memberships[]
}

model customers {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String     @db.Uuid
  name        String
  email       String?
  phone       String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  bookings    bookings[]
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_items {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String     @db.Uuid
  name               String
  category           String?
  sku                String?
  description        String?
  quantity_total     Int        @default(0)
  quantity_available Int        @default(0)
  rental_price       Decimal?   @default(0) @db.Decimal(10, 2)
  replacement_cost   Decimal?   @db.Decimal(10, 2)
  reorder_point      Int?       @default(0)
  condition          String?    @default("good")
  image_url          String?
  is_active          Boolean?   @default(true)
  created_at         DateTime?  @default(now()) @db.Timestamp(6)
  updated_at         DateTime?  @default(now()) @db.Timestamp(6)
  businesses         businesses @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model memberships {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  business_id String     @db.Uuid
  role        String     @default("staff")
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id    String    @db.Uuid
  type          String
  amount        Decimal   @db.Decimal(10, 2)
  due_date      DateTime? @db.Date
  paid_date     DateTime? @db.Date
  method        String?
  status        String    @default("pending")
  processor_ref String?
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  bookings      bookings  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([booking_id], map: "idx_payments_booking")
  @@index([due_date], map: "idx_payments_due_date")
  @@index([status], map: "idx_payments_status")
}

model users {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String        @unique
  password_hash String
  full_name     String?
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  bookings      bookings[]
  memberships   memberships[]
}
